# Variáveis usadas pela Vercel Serverless Function em /api/contact.
# Nunca commite valores reais — configure via painel da Vercel.

# Obrigatória: chave da API do Resend.
RESEND_APITOKEN=

# Opcionais: sobrescrevem remetente/destinatário padrão do formulário.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# CONTACT_TO_EMAIL=lucasmontalvao2019@gmail.com

# Opcional: usado apenas se quiser apontar o formulário de contato para um
# backend externo (ex.: rodar o backend .NET em ambiente próprio). Se ausente
# em produção, o formulário usa a serverless function /api/contact da Vercel.
# VITE_API_BASE_URL=https://backend.exemplo.com

# URL pública do backend .NET (usada pela seção de atividade no GitHub).
# Se ausente em produção, a seção não é renderizada.
# VITE_DOTNET_BASE_URL=https://portfolio-api.exemplo.onrender.com
