# Variáveis usadas pela Vercel Serverless Function em /api/contact.
# Nunca commite valores reais — configure via painel da Vercel.

# Obrigatória: chave da API do Resend.
RESEND_APITOKEN=

# Opcionais: sobrescrevem remetente/destinatário padrão do formulário.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# CONTACT_TO_EMAIL=lucasmontalvao2019@gmail.com

# Opcional: usado apenas se quiser apontar para um backend externo
# (ex.: rodar o backend .NET em ambiente próprio).
# VITE_API_BASE_URL=https://backend.exemplo.com
